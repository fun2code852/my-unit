{
  "manifest_version": 3,
  "name": "My Unit",
  "version": "0.1.0",
  "description": "Hover webpage prices to see them in one favourite unit — a custom item or a Yahoo Finance symbol.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "My Unit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "activeTab", "contextMenus"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/currencies.js", "lib/parse.js", "lib/convert.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
