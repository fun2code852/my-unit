{
  "manifest_version": 3,
  "name": "My Unit",
  "version": "0.1.0",
  "description": "Hover webpage prices to see them in one favourite unit — a custom item or a Yahoo Finance symbol.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "My Unit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
